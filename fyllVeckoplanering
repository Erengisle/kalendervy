/**
 * Fyller veckoplaneringen utifrån veckonumret i E1.
 *
 * Hämtar lektioner från Google Kalender och händelser från läsårsplanen,
 * och skriver dem i dagkolumnerna. Formateringen rörs aldrig — skriptet
 * rensar bara innehåll (clearContent), aldrig format.
 *
 * Installation:
 *   1. Öppna "Tom veckoplanering" → Tillägg → Apps Script.
 *   2. Klistra in koden, spara, ladda om kalkylarket.
 *   3. Skriv veckonummer i E1 → menyn "Veckoplanering" → "Fyll veckan".
 */

const CONFIG = {

  // ---- Kalendern ----
  kalenderId: 'primary',          // 'primary' = din egen kalender
  titelFilter: [],                // t.ex. ['SVA', 'Historia'] = bara händelser vars titel innehåller något av orden. Tom lista = alla.
  taMedHeldagshändelser: false,
  visa: {                         // vad som ska stå om varje lektion
    tid: true,
    titel: true,
    plats: false,
    beskrivning: false
  },

  // ---- Läsårsplanen ----
  läsårsplan: {
    kalkylarkId: '1Y7AQG7Ny3Mb0Tm-XWLKCg8OexEHd3_2MM0LoxWh6DgA',
    flikar: ['HT26', 'VT27'],
    placering: 'topp',            // 'topp' = ovanför lektionerna, 'botten' = under dem
    prefix: '',                   // t.ex. '» ' om du vill skilja dem från lektionerna
    veckonoteringar: true         // kolumnen "Notering" (Samverkan, APL, Beställningsperiod …) skrivs till CONFIG.blad.veckonoteringar
  },

  // ---- Mallens uppbyggnad (ändra bara om du flyttar saker i bladet) ----
  blad: {
    namn: '',                     // tomt = den aktiva fliken
    vecka: 'E1',
    år: 'E2',
    måndagsdatum: 'F1',
    rubrik: 'A1',
    datumintervall: 'A2',
    veckodagsrad: 3,
    förstaRad: 4,
    sistaRad: 16,
    förstaKolumn: 1,
    antalDagar: 5,
    veckonoteringar: 'A18'        // den sammanslagna cellen där läsårsplanens "Notering"-kolumn skrivs
  }
};

const VECKODAGAR = ['Måndag', 'Tisdag', 'Onsdag', 'Torsdag', 'Fredag'];
const MÅNADSNAMN = ['januari', 'februari', 'mars', 'april', 'maj', 'juni',
                    'juli', 'augusti', 'september', 'oktober', 'november', 'december'];


/* ============================ Meny ============================
 * Projektet har även ett byggskript (skapaVeckoplanering m.fl.) i en
 * egen fil. Den filens onOpen() måste tas bort helt — annars vinner
 * bara den ena av de två menyerna tyst, utan felmeddelande.
 * ============================================================== */

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Veckoplanering')
    .addItem('Skapa/återställ ark', 'skapaVeckoplanering')
    .addItem('Ta bort vågräta linjer i skrivytan', 'taBortVagrataLinjer')
    .addItem('Exportera som PDF (liggande)', 'exporteraPdfLiggande')
    .addSeparator()
    .addItem('Fyll veckan', 'fyllVeckan')
    .addItem('Rensa dagkolumnerna', 'rensaVeckan')
    .addSeparator()
    .addItem('Aktivera automatisk ifyllning', 'aktiveraAutomatik')
    .addItem('Stäng av automatisk ifyllning', 'stängAvAutomatik')
    .addToUi();
}


/* ============================ Huvudflöde ============================ */

function fyllVeckan(blad) {
  const b = blad || hämtaBlad_();
  const c = CONFIG.blad;

  const vecka = parseInt(b.getRange(c.vecka).getValue(), 10);
  if (!vecka || vecka < 1 || vecka > 53) {
    throw new Error('Skriv ett veckonummer i ' + c.vecka + ' först.');
  }

  const årVärde = parseInt(b.getRange(c.år).getValue(), 10);
  const år = årVärde || new Date().getFullYear();
  const måndag = måndagFörVecka_(vecka, år);

  skrivRubriker_(b, vecka, år, måndag);

  const lektioner = hämtaLektioner_(måndag);
  const plan = hämtaLäsårsplan_(vecka, måndag);

  const kolumner = [];
  for (let d = 0; d < c.antalDagar; d++) {
    const fråKalender = lektioner[d];
    const fråPlan = plan.dagar[d].map(function (t) { return CONFIG.läsårsplan.prefix + t; });
    const poster = CONFIG.läsårsplan.placering === 'botten'
      ? fråKalender.concat(fråPlan)
      : fråPlan.concat(fråKalender);
    kolumner.push(poster);
  }

  skrivDagkolumner_(b, kolumner);

  if (CONFIG.läsårsplan.veckonoteringar && c.veckonoteringar) {
    skrivVeckonoteringar_(b, plan.veckonoteringar);
  }

  const antal = lektioner.reduce(function (s, d) { return s + d.length; }, 0);
  SpreadsheetApp.getActiveSpreadsheet().toast(
    'Vecka ' + vecka + ': ' + antal + ' lektioner' + (plan.hittad ? ' + läsårsplanen' : ' (ingen matchande vecka i läsårsplanen)') + '.',
    'Klart', 5);
}


function rensaVeckan() {
  const b = hämtaBlad_();
  const c = CONFIG.blad;
  b.getRange(c.förstaRad, c.förstaKolumn, c.sistaRad - c.förstaRad + 1, c.antalDagar).clearContent();
}


/* ============================ Skriva i bladet ============================ */

function skrivRubriker_(blad, vecka, år, måndag) {
  const c = CONFIG.blad;
  const fredag = nyDag_(måndag, 4);

  sättOmEjFormel_(blad.getRange(c.rubrik), 'Veckoplanering – vecka ' + vecka);
  sättOmEjFormel_(blad.getRange(c.datumintervall),
    måndag.getDate() + ' ' + MÅNADSNAMN[måndag.getMonth()] + ' – ' +
    fredag.getDate() + ' ' + MÅNADSNAMN[fredag.getMonth()] + ' ' + fredag.getFullYear());
  sättOmEjFormel_(blad.getRange(c.måndagsdatum), måndag);
  sättOmEjFormel_(blad.getRange(c.år), år);

  const rubriker = [];
  for (let d = 0; d < c.antalDagar; d++) {
    const dag = nyDag_(måndag, d);
    rubriker.push(VECKODAGAR[d] + '  ' + dag.getDate() + '/' + (dag.getMonth() + 1));
  }
  const rad = blad.getRange(c.veckodagsrad, c.förstaKolumn, 1, c.antalDagar);
  if (rad.getFormulas()[0].join('') === '') rad.setValues([rubriker]);
}


function skrivDagkolumner_(blad, kolumner) {
  const c = CONFIG.blad;
  const antalRader = c.sistaRad - c.förstaRad + 1;
  const område = blad.getRange(c.förstaRad, c.förstaKolumn, antalRader, c.antalDagar);
  område.clearContent();

  let trångt = false;
  const rutnät = [];
  for (let r = 0; r < antalRader; r++) {
    const rad = [];
    for (let d = 0; d < c.antalDagar; d++) {
      const poster = kolumner[d];
      if (r < antalRader - 1) {
        rad.push(tillRikText_(poster[r] || ''));
      } else if (poster.length > antalRader) {
        trångt = true;
        rad.push(tillRikText_(poster.slice(antalRader - 1).join(' / ')));   // det som inte får plats slås ihop på sista raden
      } else {
        rad.push(tillRikText_(poster[r] || ''));
      }
    }
    rutnät.push(rad);
  }
  område.setRichTextValues(rutnät);

  if (trångt) {
    SpreadsheetApp.getActiveSpreadsheet().toast(
      'Någon dag hade fler poster än ' + antalRader + ' rader. Överskottet ligger ihopslaget på sista raden.',
      'Obs', 8);
  }
}


function sättOmEjFormel_(cell, värde) {
  if (cell.getFormula() === '') cell.setValue(värde);
}


// Skriver läsårsplanens "Notering"-kolumn (sådant som gäller hela veckan
// eller ännu inte har ett bestämt datum) till den egna cellen i CONFIG.blad.
function skrivVeckonoteringar_(blad, noteringar) {
  const text = noteringar
    .map(function (t) { return CONFIG.läsårsplan.prefix + t; })
    .join(' • ');
  blad.getRange(CONFIG.blad.veckonoteringar).setValue(text);
}


// Text är fetstilad som standard (t.ex. läsårsplanens poster, som saknar
// klockslag). Har posten ett klockslag (en lektion) förblir klockslaget
// fett, men allt efter det - lektionens titel - blir vanlig text fram
// till nästa post (skiljetecknet " / " vid överfulla dagar) eller radens slut.
function tillRikText_(text) {
  const byggare = SpreadsheetApp.newRichTextValue().setText(text);
  if (text.length === 0) return byggare.build();

  const fet = SpreadsheetApp.newTextStyle().setBold(true).build();
  const vanlig = SpreadsheetApp.newTextStyle().setBold(false).build();
  byggare.setTextStyle(0, text.length, fet);

  const klockslagsmönster = /\d{2}:\d{2}–\d{2}:\d{2}/g;
  let träff;
  while ((träff = klockslagsmönster.exec(text)) !== null) {
    const start = träff.index + träff[0].length;
    const nästaPost = text.indexOf(' / ', start);
    const slut = nästaPost === -1 ? text.length : nästaPost;
    if (slut > start) byggare.setTextStyle(start, slut, vanlig);
  }
  return byggare.build();
}


/* ============================ Kalendern ============================ */

function hämtaLektioner_(måndag) {
  const kalender = CONFIG.kalenderId === 'primary'
    ? CalendarApp.getDefaultCalendar()
    : CalendarApp.getCalendarById(CONFIG.kalenderId);
  if (!kalender) throw new Error('Hittar ingen kalender med id: ' + CONFIG.kalenderId);

  const dagar = [];
  for (let d = 0; d < CONFIG.blad.antalDagar; d++) {
    const start = nyDag_(måndag, d);
    const slut = nyDag_(måndag, d + 1);

    const poster = kalender.getEvents(start, slut)
      .filter(function (e) { return CONFIG.taMedHeldagshändelser || !e.isAllDayEvent(); })
      .filter(function (e) { return matcharFilter_(e.getTitle()); })
      .sort(function (a, b) { return a.getStartTime() - b.getStartTime(); })
      .map(formateraLektion_);

    dagar.push(poster);
  }
  return dagar;
}


function matcharFilter_(titel) {
  if (!CONFIG.titelFilter.length) return true;
  const t = String(titel).toLowerCase();
  return CONFIG.titelFilter.some(function (ord) { return t.indexOf(String(ord).toLowerCase()) !== -1; });
}


function formateraLektion_(e) {
  const v = CONFIG.visa;
  const delar = [];

  if (v.tid && !e.isAllDayEvent()) {
    delar.push(klockslag_(e.getStartTime()) + '–' + klockslag_(e.getEndTime()));
  }
  if (v.titel) delar.push(rensaRumsbokning_(e.getTitle()));

  let text = delar.join(' ');
  if (v.plats && e.getLocation()) text += ' (' + e.getLocation() + ')';
  if (v.beskrivning && e.getDescription()) {
    text += ' – ' + String(e.getDescription()).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  }
  return text.trim();
}


/**
 * Skolans kalendersystem klistrar in rumsbokningen sist i titeln, t.ex.
 * "SVEN1000X (SVA1NAB26) (4113, Widerströmska gymnasiet-1-4113 (32))".
 * Den delen känns igen på att den innehåller en kapacitetssiffra i en
 * egen parentes (t.ex. "(32)") — det gör aldrig kurs-/klasskoden. Bara
 * den sista parentesgruppen tas bort om den matchar, resten av titeln
 * (kurskod + klasskod) lämnas orörd.
 */
function rensaRumsbokning_(titel) {
  const text = String(titel);
  const sistaGrupp = text.match(/\((?:[^()]|\([^()]*\))*\)\s*$/);
  if (sistaGrupp && /\(\d+\)/.test(sistaGrupp[0])) {
    return text.slice(0, sistaGrupp.index).trim();
  }
  return text.trim();
}


function klockslag_(datum) {
  return Utilities.formatDate(datum, Session.getScriptTimeZone(), 'HH:mm');
}


/* ============================ Läsårsplanen ============================ */

/**
 * Läsårsplanen är ett kalendarium: ett block per vecka, veckonumret i kolumn A,
 * och varje veckodag upptar två kolumner (riktigt datum i den vänstra,
 * noteringar i båda). Blocket hittas via veckonumret och kontrolleras mot
 * måndagens datum. Kolumnernas position läses av från rubrikraden
 * ("Måndag", "Tisdag" … "Notering") istället för att antas vara fast,
 * så att planen fortsätter fungera även om en kolumn flyttas.
 */
function hämtaLäsårsplan_(vecka, måndag) {
  const tomt = { hittad: false, dagar: [[], [], [], [], []], veckonoteringar: [] };
  const cfg = CONFIG.läsårsplan;
  if (!cfg.kalkylarkId) return tomt;

  const ss = SpreadsheetApp.openById(cfg.kalkylarkId);
  const allaBlad = ss.getSheets();
  let någonFlikHittad = false;

  for (let i = 0; i < cfg.flikar.length; i++) {
    const blad = hittaFlik_(allaBlad, cfg.flikar[i]);
    if (!blad) continue;
    någonFlikHittad = true;

    const värden = blad.getDataRange().getValues();
    const rubriker = hittaRubrikkolumner_(värden);
    if (!rubriker) {
      throw new Error('Hittar ingen rubrikrad med "Måndag" i fliken "' + blad.getName() + '" i läsårsplanen.');
    }

    const block = hittaVeckoblock_(värden, vecka, måndag, rubriker.dagkolumner);
    if (block) return läsBlock_(värden, block, rubriker.dagkolumner, rubriker.noteringskolumn);
  }

  if (!någonFlikHittad) {
    throw new Error('Hittar ingen av flikarna [' + cfg.flikar.join(', ') + '] i läsårsplanen. ' +
      'Flikar som finns i kalkylarket: ' + allaBlad.map(function (b) { return b.getName(); }).join(', '));
  }
  return tomt;
}


// Matchar flikNamn oavsett mellanslag och skiftläge, så att t.ex. "VT 2026"
// och "VT2026" hittas — annars hoppade koden tyst vidare (continue) om
// fliknamnet i CONFIG inte råkade stavas exakt som i kalkylarket.
function hittaFlik_(allaBlad, flikNamn) {
  const normalisera = function (s) { return String(s).replace(/\s+/g, ' ').trim().toLowerCase(); };
  const mål = normalisera(flikNamn);
  for (let i = 0; i < allaBlad.length; i++) {
    if (normalisera(allaBlad[i].getName()) === mål) return allaBlad[i];
  }
  return null;
}


// Hittar rubrikraden ("Måndag", "Tisdag" … "Notering") bland de första
// raderna i bladet och läser av var dagarnas datumkolumner och
// noteringskolumnen faktiskt ligger, istället för att anta fasta positioner.
function hittaRubrikkolumner_(värden) {
  for (let r = 0; r < Math.min(värden.length, 10); r++) {
    const rad = värden[r].map(function (v) { return String(v).trim().toLowerCase(); });
    const måndagIx = rad.indexOf('måndag');
    if (måndagIx === -1) continue;

    const dagkolumner = [0, 1, 2, 3, 4].map(function (d) { return måndagIx + d * 2; });
    const noteringIx = rad.indexOf('notering');
    return { dagkolumner: dagkolumner, noteringskolumn: noteringIx === -1 ? null : noteringIx };
  }
  return null;
}


// En "datumrad" är raden överst i varje veckoblock, där varje veckodags
// kolumn innehåller ett riktigt datumvärde (inte text).
function ärDatumrad_(rad, dagkolumner) {
  const träffar = dagkolumner.filter(function (k) { return rad[k] instanceof Date; });
  return träffar.length >= 3;
}


function hittaVeckoblock_(värden, vecka, måndag, dagkolumner) {
  const datumrader = [];
  for (let r = 0; r < värden.length; r++) {
    if (ärDatumrad_(värden[r], dagkolumner)) datumrader.push(r);
  }

  for (let i = 0; i < datumrader.length; i++) {
    const start = datumrader[i];
    const slut = (i + 1 < datumrader.length ? datumrader[i + 1] : värden.length) - 1;

    let veckonr = null;
    for (let r = start; r <= slut; r++) {
      const v = parseInt(String(värden[r][0]).trim(), 10);
      if (v >= 1 && v <= 53 && String(värden[r][0]).trim() === String(v)) { veckonr = v; break; }
    }
    if (veckonr !== vecka) continue;

    // kontroll: måndagens datum i blocket ska stämma med den efterfrågade måndagen
    if (!sammaDag_(värden[start][dagkolumner[0]], måndag)) continue;

    return { start: start, slut: slut };
  }
  return null;
}


function sammaDag_(datum, måndag) {
  return datum instanceof Date &&
    datum.getFullYear() === måndag.getFullYear() &&
    datum.getMonth() === måndag.getMonth() &&
    datum.getDate() === måndag.getDate();
}


function läsBlock_(värden, block, dagkolumner, noteringskolumn) {
  const dagar = [];

  for (let d = 0; d < 5; d++) {
    const kol = dagkolumner[d];
    const poster = [];
    for (let r = block.start; r <= block.slut; r++) {
      for (let k = kol; k <= kol + 1; k++) {
        if (r === block.start && k === kol) continue;   // själva datumcellen
        lägTill_(poster, värden[r][k]);
      }
    }
    dagar.push(poster);
  }

  const veckonoteringar = [];
  for (let r = block.start; r <= block.slut; r++) {
    // A/B-vecka står i kolumn A
    const a = String(värden[r][0]).trim();
    if (/^[AB]-vecka$/i.test(a)) lägTill_(veckonoteringar, a);
    if (noteringskolumn !== null) lägTill_(veckonoteringar, värden[r][noteringskolumn]);
  }

  return { hittad: true, dagar: dagar, veckonoteringar: veckonoteringar };
}


function lägTill_(lista, värde) {
  if (värde === null || värde === undefined) return;
  const text = (värde instanceof Date)
    ? Utilities.formatDate(värde, Session.getScriptTimeZone(), 'yyyy-MM-dd')
    : String(värde).replace(/\s+/g, ' ').trim();
  if (text && lista.indexOf(text) === -1) lista.push(text);
}


/* ============================ Automatik (valfritt) ============================ */

function aktiveraAutomatik() {
  stängAvAutomatik();
  ScriptApp.newTrigger('vidRedigering_')
    .forSpreadsheet(SpreadsheetApp.getActive())
    .onEdit()
    .create();
  SpreadsheetApp.getActiveSpreadsheet().toast('Veckan fylls nu automatiskt när du ändrar ' + CONFIG.blad.vecka + '.', 'Klart', 5);
}


function stängAvAutomatik() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'vidRedigering_') ScriptApp.deleteTrigger(t);
  });
}


function vidRedigering_(e) {
  if (!e || !e.range) return;
  if (e.range.getA1Notation() !== CONFIG.blad.vecka) return;
  const blad = e.range.getSheet();
  if (CONFIG.blad.namn && blad.getName() !== CONFIG.blad.namn) return;
  fyllVeckan(blad);
}


/* ============================ Hjälpfunktioner ============================ */

function hämtaBlad_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!CONFIG.blad.namn) return ss.getActiveSheet();
  const b = ss.getSheetByName(CONFIG.blad.namn);
  if (!b) throw new Error('Hittar inget blad som heter "' + CONFIG.blad.namn + '".');
  return b;
}


function måndagFörVecka_(vecka, år) {
  const jan4 = new Date(år, 0, 4);
  const dag = jan4.getDay() || 7;                 // ISO: måndag = 1
  const måndagVecka1 = new Date(år, 0, 4 - (dag - 1));
  return nyDag_(måndagVecka1, (vecka - 1) * 7);
}


function nyDag_(datum, antalDagar) {
  return new Date(datum.getFullYear(), datum.getMonth(), datum.getDate() + antalDagar);
}
